{
  "version": "0.2",
  "name": "Disc on a Festlager with spring and moment",
  "description": "Disc pinned at its centre. A spring from the ceiling to its rim (ghost = relaxed state, shorter than installed, so it starts in tension) and a constant clockwise moment. Small oscillations have omega = sqrt(2 k / m).",
  "gravity": [
    0,
    -9.81
  ],
  "solver": {
    "dt": 0.001
  },
  "view": {
    "center": [
      0.1,
      0.8
    ],
    "width": 2.4
  },
  "surfaces": [
    {
      "id": "ceiling",
      "p1": [
        1.2,
        1.4
      ],
      "p2": [
        -0.8,
        1.4
      ]
    }
  ],
  "bodies": [
    {
      "id": "disc",
      "type": "disc",
      "position": [
        0.0,
        0.6
      ],
      "params": {
        "mass": 1.5,
        "radius": 0.25
      }
    }
  ],
  "elements": [
    {
      "id": "k1",
      "type": "spring",
      "a": {
        "body": null,
        "point": [
          0.25,
          1.4
        ]
      },
      "b": {
        "body": "disc",
        "point": [
          0.25,
          0.0
        ]
      },
      "params": {
        "k": 30.0,
        "rest_length": 0.5
      }
    },
    {
      "id": "M1",
      "type": "load",
      "body": "disc",
      "point": [
        0.0,
        0.0
      ],
      "params": {
        "moment": -1.0,
        "mode": "constant"
      }
    }
  ],
  "constraints": [
    {
      "id": "A",
      "type": "pin_support",
      "body": "disc",
      "point": [
        0.0,
        0.0
      ],
      "surface": null,
      "params": {
        "angle": 0.0
      }
    }
  ]
}
