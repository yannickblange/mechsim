{
  "version": "0.2",
  "name": "Disc with constant force and spring",
  "description": "Disc on a Loslager sliding along a floor. A constant force pushes it right, a pre-stretched spring (ghost = relaxed state) pulls it left; it oscillates about the new equilibrium.",
  "gravity": [
    0,
    -9.81
  ],
  "solver": {
    "dt": 0.001
  },
  "view": {
    "center": [
      0,
      0.3
    ],
    "width": 2.8
  },
  "surfaces": [
    {
      "id": "floor",
      "p1": [
        -1.3,
        0
      ],
      "p2": [
        1.3,
        0
      ]
    }
  ],
  "bodies": [
    {
      "id": "disc",
      "type": "disc",
      "position": [
        0.0,
        0.15
      ],
      "params": {
        "mass": 1.5,
        "radius": 0.15
      }
    }
  ],
  "elements": [
    {
      "id": "k1",
      "type": "spring",
      "a": {
        "body": null,
        "point": [
          -1.0,
          0.15
        ]
      },
      "b": {
        "body": "disc",
        "point": [
          -0.15,
          0.0
        ]
      },
      "params": {
        "k": 30.0,
        "rest_length": 0.6
      }
    },
    {
      "id": "F1",
      "type": "load",
      "body": "disc",
      "point": [
        0.15,
        0.0
      ],
      "params": {
        "force": [
          12.0,
          0.0
        ],
        "mode": "constant"
      }
    }
  ],
  "constraints": [
    {
      "id": "B",
      "type": "roller_support",
      "body": "disc",
      "point": [
        0.0,
        -0.15
      ],
      "surface": "floor",
      "params": {
        "angle": 0.0
      }
    }
  ]
}
