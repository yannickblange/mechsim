{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechsim/state.schema.json",
  "title": "MechSim frame v0.3",
  "description": "One simulation frame, produced by ms_world_frame_json() and sent to the browser.",
  "type": "object",
  "required": ["t", "bodies", "elements", "constraints", "energy"],
  "additionalProperties": false,
  "properties": {
    "t": { "type": "number" },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "phi", "vx", "vy", "omega"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "phi": { "type": "number" },
          "vx": { "type": "number" },
          "vy": { "type": "number" },
          "omega": { "type": "number" }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "p1", "p2", "force"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "p1": { "$ref": "#/$defs/vec2", "description": "World position of anchor a (load: application point)." },
          "p2": { "$ref": "#/$defs/vec2", "description": "World position of anchor b (load: the same point as p1)." },
          "force": { "type": "number", "description": "Axial force, positive = tension (spring); magnitude of the force or impulse (load)." },
          "vector": { "$ref": "#/$defs/vec2", "description": "load only: force or impulse vector, world frame." },
          "moment": { "type": "number", "description": "load only: moment or angular impulse." },
          "mode": { "enum": ["constant", "impulse"], "description": "load only." },
          "active": { "type": "boolean", "description": "load only: false once an impulse has been applied (t > 0)." }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "position", "reaction"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "position": { "$ref": "#/$defs/vec2", "description": "World position of the support." },
          "reaction": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 3,
            "description": "[Fx, Fy] or [Fx, Fy, M] exerted by the support on the body (rope, rod: force on end b; joints: on body a)."
          },
          "p1": { "$ref": "#/$defs/vec2", "description": "rope, rod: world position of end a." },
          "p2": { "$ref": "#/$defs/vec2", "description": "rope, rod: world position of end b." },
          "force": { "type": "number", "description": "rope, rod: axial force, tension positive (a rod in compression is negative)." },
          "length": { "type": "number", "description": "rope, rod: the length L (rope: maximum length)." },
          "taut": { "type": "boolean", "description": "rope: false while slack; rod: always true." }
        }
      }
    },
    "energy": {
      "type": "object",
      "required": ["kinetic", "potential"],
      "additionalProperties": false,
      "properties": {
        "kinetic": { "type": "number" },
        "potential": { "type": "number" }
      }
    }
  },
  "$defs": {
    "vec2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
  }
}
