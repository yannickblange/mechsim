{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechsim/scene.schema.json",
  "title": "MechSim scene v0.3",
  "description": "v0.2 added surfaces, discs, loads (force and moment), fixed and roller supports; v0.3 adds rope, rod (Stab), pin and fixed joints and Festlager in free space. Version 0.1 and 0.2 scenes remain valid.",
  "type": "object",
  "required": ["version", "bodies"],
  "additionalProperties": false,
  "properties": {
    "version": { "enum": ["0.1", "0.2", "0.3"] },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "gravity": { "$ref": "#/$defs/vec2", "default": [0, -9.81] },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dt": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1, "default": 0.001 },
        "integrator": { "enum": ["semi_implicit_euler"], "default": "semi_implicit_euler" },
        "baumgarte_alpha": { "type": "number", "minimum": 0, "default": 5.0 },
        "baumgarte_beta": { "type": "number", "minimum": 0, "default": 5.0 }
      }
    },
    "view": {
      "type": "object",
      "description": "Optional hint for the frontend camera. Ignored by the engine.",
      "additionalProperties": false,
      "properties": {
        "center": { "$ref": "#/$defs/vec2" },
        "width": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "surfaces": {
      "type": "array",
      "default": [],
      "description": "Fixed line segments (v0.2). Pure geometry: supports sit on them, bodies do not collide with them. Ignored by the engine.",
      "items": { "$ref": "#/$defs/surface" }
    },
    "bodies": {
      "type": "array",
      "items": { "$ref": "#/$defs/body" }
    },
    "elements": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/element" }
    },
    "constraints": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/constraint" }
    }
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]+$" },
    "anchor": {
      "type": "object",
      "required": ["body", "point"],
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "Body id, or null for ground.",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "point": {
          "$ref": "#/$defs/vec2",
          "description": "Body-local point if body is set, world point if body is null."
        }
      }
    },
    "surface": {
      "type": "object",
      "required": ["id", "p1", "p2"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "p1": { "$ref": "#/$defs/vec2", "description": "World start point. The hatching is drawn on the right-hand side of p1 -> p2." },
        "p2": { "$ref": "#/$defs/vec2", "description": "World end point." }
      }
    },
    "body": {
      "type": "object",
      "required": ["id", "type", "position", "params"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["block", "disc"] },
        "position": { "$ref": "#/$defs/vec2" },
        "angle": { "type": "number", "default": 0 },
        "velocity": { "$ref": "#/$defs/vec2", "default": [0, 0] },
        "omega": { "type": "number", "default": 0 },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "block" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/blockParams" } } }
        },
        {
          "if": { "properties": { "type": { "const": "disc" } } },
          "then": { "properties": { "params": { "$ref": "#/$defs/discParams" } } }
        }
      ]
    },
    "blockParams": {
      "type": "object",
      "required": ["mass", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "mass": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "discParams": {
      "type": "object",
      "required": ["mass", "radius"],
      "additionalProperties": false,
      "properties": {
        "mass": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "type", "params"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["spring", "load"] },
        "a": { "$ref": "#/$defs/anchor" },
        "b": { "$ref": "#/$defs/anchor" },
        "body": { "$ref": "#/$defs/id", "description": "load: the body the load acts on." },
        "point": { "$ref": "#/$defs/vec2", "description": "load: body-local application point." },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "spring" } } },
          "then": {
            "required": ["a", "b"],
            "not": { "anyOf": [{ "required": ["body"] }, { "required": ["point"] }] },
            "properties": { "params": { "$ref": "#/$defs/springParams" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "load" } } },
          "then": {
            "required": ["body", "point"],
            "not": { "anyOf": [{ "required": ["a"] }, { "required": ["b"] }] },
            "properties": { "params": { "$ref": "#/$defs/loadParams" } }
          }
        }
      ]
    },
    "springParams": {
      "type": "object",
      "required": ["k"],
      "additionalProperties": false,
      "properties": {
        "k": { "type": "number", "minimum": 0 },
        "rest_length": {
          "type": "number",
          "minimum": 0,
          "description": "Relaxed length. If omitted, the initial distance between a and b is used. If it differs from the initial distance the spring starts loaded: tension (pulls the ends together) when the initial distance is larger, compression when it is smaller."
        }
      }
    },
    "loadParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "force": {
          "$ref": "#/$defs/vec2",
          "default": [0, 0],
          "description": "World-frame vector, N (constant) or N s (impulse). Does not rotate with the body."
        },
        "moment": {
          "type": "number",
          "default": 0,
          "description": "Couple, N m (constant) or N m s (impulse), counter-clockwise positive."
        },
        "mode": {
          "enum": ["constant", "impulse"],
          "default": "constant",
          "description": "constant acts for the whole simulation; impulse is a velocity jump at t = 0 (and after every reset)."
        }
      }
    },
    "bodyAnchor": {
      "type": "object",
      "required": ["body", "point"],
      "additionalProperties": false,
      "properties": {
        "body": { "$ref": "#/$defs/id" },
        "point": { "$ref": "#/$defs/vec2", "description": "Body-local point." }
      }
    },
    "constraint": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["pin_support", "fixed_support", "roller_support", "rope", "rod", "pin_joint", "fixed_joint"]
        },
        "body": {
          "description": "Supports: the mass the support is on. pin_support only: null = Festlager in free space (point is then a world point).",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "point": {
          "$ref": "#/$defs/vec2",
          "description": "Supports: body-local point (world point for a free-space pin_support). The support is fixed at its initial world position."
        },
        "surface": {
          "description": "Supports: optional id of the surface the support sits on (editor reference only; the engine uses params.angle).",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "a": { "$ref": "#/$defs/anchor", "description": "rope, rod: first end. pin_joint, fixed_joint: point on the first mass." },
        "b": { "$ref": "#/$defs/anchor", "description": "rope, rod: second end. pin_joint, fixed_joint: point on the second mass." },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "pin_support" } } },
          "then": {
            "required": ["body", "point"],
            "not": { "anyOf": [{ "required": ["a"] }, { "required": ["b"] }] },
            "properties": { "params": { "$ref": "#/$defs/supportParams" } }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["fixed_support", "roller_support"] } } },
          "then": {
            "required": ["body", "point"],
            "not": { "anyOf": [{ "required": ["a"] }, { "required": ["b"] }] },
            "properties": { "body": { "$ref": "#/$defs/id" }, "params": { "$ref": "#/$defs/supportParams" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "rope" } } },
          "then": {
            "required": ["a", "b"],
            "not": { "anyOf": [{ "required": ["body"] }, { "required": ["point"] }, { "required": ["surface"] }] },
            "properties": { "params": { "$ref": "#/$defs/ropeParams" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "rod" } } },
          "then": {
            "required": ["a", "b"],
            "not": { "anyOf": [{ "required": ["body"] }, { "required": ["point"] }, { "required": ["surface"] }] },
            "properties": { "params": { "$ref": "#/$defs/noParams" } }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["pin_joint", "fixed_joint"] } } },
          "then": {
            "required": ["a", "b"],
            "not": { "anyOf": [{ "required": ["body"] }, { "required": ["point"] }, { "required": ["surface"] }] },
            "properties": {
              "a": { "$ref": "#/$defs/bodyAnchor" },
              "b": { "$ref": "#/$defs/bodyAnchor" },
              "params": { "$ref": "#/$defs/noParams" }
            }
          }
        }
      ]
    },
    "ropeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Maximum length. If omitted, the initial distance between the ends is used (taut). Must not be shorter than the initial distance; longer means the rope starts slack."
        }
      }
    },
    "noParams": { "type": "object", "additionalProperties": false },
    "supportParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "angle": {
          "type": "number",
          "default": 0,
          "description": "Direction of the supporting surface line in rad, counter-clockwise from +x, chosen so that the body lies on its left side (angle 0: floor below the body). roller_support slides along this line and reacts normal to it; the other supports use it for the symbol only."
        }
      }
    }
  }
}
